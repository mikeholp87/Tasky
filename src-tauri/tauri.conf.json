{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasky",
  "version": "0.1.0",
  "identifier": "com.taskmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tasky",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://speed.cloudflare.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Task Manager contributors",
    "copyright": "Copyright © 2026 Mike Holp. MIT License.",
    "category": "Utility",
    "shortDescription": "Cross-platform task manager and system monitor",
    "longDescription": "Monitor processes, CPU, memory, storage and network in real time, and safely end, suspend or reprioritize processes. All data stays on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"]
      }
    }
  }
}
