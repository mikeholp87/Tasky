{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager",
  "version": "0.1.0",
  "identifier": "com.taskmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tasky",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Task Manager contributors",
    "copyright": "Copyright \u00a9 2026 Mike Holp. MIT License.",
    "category": "Utility",
    "shortDescription": "Cross-platform task manager and system monitor",
    "longDescription": "Monitor processes, CPU, memory, storage and network in real time, and safely end, suspend or reprioritize processes. All data stays on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "recommends": ["libvulkan1", "mesa-vulkan-drivers"],
        "desktopTemplate": "linux/taskmanager.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"],
        "desktopTemplate": "linux/taskmanager.desktop"
      }
    },
    "resources": ["licenses/webpki-roots-CDLA-2.0.txt"]
  }
}
